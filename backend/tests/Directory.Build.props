<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Test classes are public by xunit convention and test names use underscores. -->
    <NoWarn>$(NoWarn);CA1515;CA1707;CA1816;CA2007;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Using Include="NSubstitute" Condition="'$(MSBuildProjectName)' == 'Tms.UnitTests'" />
  </ItemGroup>
</Project>
